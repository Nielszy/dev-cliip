        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (source, serial_no) (gnmic_components_component_state_serial_no{source=~\"${device}\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (source, software_version) (gnmic_system_state_software_version{source=~\"${device}\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "F"
        }
      ],
