    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Static system information per device, collected once by the gNMIc arista_system_info subscription when gNMIc connects to the device.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "options": {
        "cellHeight": "sm",
        "enablePagination": false,
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Device",
            "desc": false
          }
        ]
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (source, hostname) (gnmic_system_state_hostname{source=~\"${device}\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (source, part_no) (gnmic_components_component_state_part_no{source=~\"${device}\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (source, description) (gnmic_components_component_state_description{source=~\"${device}\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "C"
